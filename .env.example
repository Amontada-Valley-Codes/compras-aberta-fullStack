# ==============================================================================
# COMPRAS ABERTAS — TEMPLATE UNIFICADO (.env.example)
# ==============================================================================
# Copie este arquivo para .env na raiz (ou no servidor em ~/apps/comprasabertas/.env)
# e preencha os valores reais. Nunca faça commit do arquivo .env com credenciais reais.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIDOR, URLS & SEGURANÇA
# ------------------------------------------------------------------------------
PORT=3333
LOG_LEVEL="info"
TRUST_PROXY="false"
# Em produção no servidor: https://comprasabertas.amontadavalley.com.br
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

API_BASE_URL="http://localhost:3333"
BACKEND_URL="http://localhost:3333"
JWT_SECRET="defina_um_segredo_com_pelo_menos_32_caracteres_aqui"

# ------------------------------------------------------------------------------
# 2. BANCO DE DADOS (PostgreSQL / Supabase Pooler)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USUARIO:SENHA@HOST:5432/postgres"

# ------------------------------------------------------------------------------
# 3. APIS EXTERNAS (Dados Públicos & Receita Federal)
# ------------------------------------------------------------------------------
API_DADOS="https://comprasabertas.amontadavalley.com.br/api-dados"
ANALYTICS_API_BASE_URL="https://comprasabertas.amontadavalley.com.br/api-dados"
OPEN_CNPJ_API="https://api.opencnpj.org"
ANALYTICS_CACHE_TTL_SECONDS=300

# ------------------------------------------------------------------------------
# 4. SUPABASE STORAGE (Upload de Documentos de Empresas)
# ------------------------------------------------------------------------------
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sua_service_role_key_do_supabase"
SUPABASE_STORAGE_BUCKET="documentos-empresas"

# ------------------------------------------------------------------------------
# 5. CREDENCIAIS ADMINISTRATIVAS INICIAIS
# ------------------------------------------------------------------------------
ADMIN_EMAIL="admin@exemplo.com"
ADMIN_PASSWORD="sua_senha_admin"

# ------------------------------------------------------------------------------
# 6. E-MAIL / NOTIFICAÇÕES (Gmail SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="seuemail@gmail.com"
SMTP_PASS="sua_senha_de_app_16_caracteres"
SMTP_FROM=""

# ------------------------------------------------------------------------------
# 7. PAGAMENTOS & ASSINATURAS (Stripe)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLIC_KEY="pk_test_..."
STRIPE_PRICE_ID_MONTHLY="price_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ------------------------------------------------------------------------------
# 8. ASSISTENTE VIRTUAL & CANAIS DE CONTATO (Frontend)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_NOUPE_CHATBOT_URL="https://www.noupe.com/embed/seu_id_do_chatbot.js"
NEXT_PUBLIC_CONTACT_WHATSAPP=""
NEXT_PUBLIC_CONTACT_EMAIL=""

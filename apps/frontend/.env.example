# Segredo usado para validar (não para emitir) o JWT de sessão em proxy.ts e
# nas rotas /api/auth/*. TEM que ser o mesmo valor de JWT_SECRET em
# apps/backend/.env — é o mesmo token, só que verificado aqui também.
JWT_SECRET=

# URL do backend Fastify. Em produção, aponta para onde ele estiver hospedado.
API_BASE_URL=http://localhost:3333
# Alternativa aceita pelo cliente (api/client.ts) quando API_BASE_URL não é definida.
# BACKEND_URL=http://localhost:3333

# URL da API pública de análise de dados (catálogo de municípios). Só precisa
# ser definida se for diferente do valor padrão já usado no código.
# ANALYTICS_API_BASE_URL=https://compra-aberta-api.onrender.com
